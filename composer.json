{
    "name": "witify/support",
    "description": "Base classes of the Witify Laravel applications: actions, controllers, resources, query builders, confirmation flow, rich text sanitization and module providers.",
    "keywords": ["laravel", "support", "witify"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Witify",
            "email": "info@witify.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0|^12.0",
        "illuminate/broadcasting": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/notifications": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/translation": "^11.0|^12.0",
        "symfony/html-sanitizer": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Witify\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Witify\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Witify\\Support\\SupportServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
